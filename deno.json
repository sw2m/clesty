{
  "name": "@sw2m/clesty",
  "version": "0.0.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "test": "deno test --allow-read --allow-write",
    "test:coverage": "deno test --allow-read --allow-write --coverage=coverage && deno coverage coverage",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/ tests/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@hey-api/openapi-ts": "npm:@hey-api/openapi-ts@^0.96.1",
    "fast-check": "npm:fast-check@^3"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["coverage/", "tests/fixtures/"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["coverage/", "tests/fixtures/"]
  },
  "exclude": [
    "coverage/",
    "node_modules/"
  ]
}
